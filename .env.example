# ============================================================
#  Configuración de Kokoro Web (TTS)
#  Copia este archivo a .env y ajusta los valores:
#      cp .env.example .env
# ============================================================

# Puerto en el que se publica la interfaz web en tu VPS (modo simple).
# Accederás en:  http://IP_DE_TU_VPS:3000
KW_PORT=3000

# Clave para proteger la API (endpoints compatibles con OpenAI).
# Genera una segura con:   openssl rand -hex 32
# Si la dejas vacía, la API queda SIN autenticación (no recomendado en
# un servidor accesible desde internet).
KW_SECRET_API_KEY=

# Analíticas anónimas de uso. true = NO enviar nada.
KW_PUBLIC_NO_TRACK=true

# ------------------------------------------------------------
#  Solo para el modo con dominio + HTTPS (docker-compose.https.yml)
# ------------------------------------------------------------
# Tu dominio o subdominio ya apuntando (registro A) a la IP del VPS.
KW_DOMAIN=tts.midominio.com

# Email para los avisos de Let's Encrypt (renovación de certificados).
KW_ACME_EMAIL=tu-correo@ejemplo.com
