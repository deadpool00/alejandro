# ============================================================
#  Voiceover Studio — configuración
#  Copia a .env y rellena:   cp .env.example .env
# ============================================================

# Dominio público. Debe apuntar por DNS (registro A) a la IP del VPS.
KOKORO_DOMAIN=voz.akumalao.com

# Usuario y contraseña para entrar a la web (basic auth de Traefik),
# en formato htpasswd:  usuario:hash
#
# ⚠️  IMPORTANTE: en el .env hay que DUPLICAR cada "$" como "$$"
#     (docker compose lo exige, si no el hash se corrompe).
#
# Para generar un hash nuevo:
#   docker run --rm httpd:alpine htpasswd -nbB miusuario 'MiPassword'
#   -> copia el resultado y cambia cada  $  por  $$  antes de pegarlo aquí.
#
# Ejemplo (placeholder, reemplázalo por el tuyo):
KOKORO_BASICAUTH=akuma:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxxx
